rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: users can view profiles, create/update only their own
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Saved posts subcollection
      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Communities and memberships
    match /communities/{communityId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;

      // Members subcollection
      match /members/{memberId} {
        allow read: if true;
        allow write: if isOwner(memberId);
      }
    }

    // Posts, comments, and votes
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      // Authors can update content; any authenticated user can increment upvotes/commentsCount
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }

      // Votes subcollection
      match /votes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // Official Notices: publicly readable; creation/modification restricted to staff/faculty/admin roles
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        request.resource.data.authorRole in ['Admin', 'Faculty', 'COE Staff', 'Deanery', 'Staff', 'administrator', 'moderator', 'Official Staff'] ||
        request.auth.token.role in ['admin', 'faculty', 'staff'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Faculty', 'Staff', 'moderator'])
      );
    }
  }
}
