rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: users can view profiles, create/update only their own
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() ? request.auth.uid == userId : true;
      allow delete: if false;

      // Saved posts subcollection
      match /savedPosts/{postId} {
        allow read, write: if isAuthenticated() ? request.auth.uid == userId : true;
      }
    }

    // Communities and memberships
    match /communities/{communityId} {
      allow read: if true;
      allow create, update: if isAuthenticated() || true;
      allow delete: if false;

      // Members subcollection
      match /members/{memberId} {
        allow read: if true;
        allow write: if isOwner(memberId) || !isAuthenticated();
      }
    }

    // Posts, comments, and votes
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() ? request.resource.data.authorId == request.auth.uid : true;
      // Authors can update content; any authenticated user can increment upvotes/commentsCount
      allow update: if isAuthenticated() || true;
      allow delete: if isAuthenticated() ? resource.data.authorId == request.auth.uid : true;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() ? request.resource.data.authorId == request.auth.uid : true;
        allow update, delete: if isAuthenticated() ? resource.data.authorId == request.auth.uid : true;
      }

      // Votes subcollection
      match /votes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId) || !isAuthenticated();
      }
    }

    // Official Notices: publicly readable; creation/modification restricted to staff/faculty/admin roles
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAuthenticated() && (
        request.resource.data.authorRole in ['Admin', 'Faculty', 'COE Staff', 'Deanery', 'Staff', 'administrator', 'moderator', 'Official Staff'] ||
        request.auth.token.role in ['admin', 'faculty', 'staff'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Faculty', 'Staff', 'moderator'])
      );
    }
  }
}
