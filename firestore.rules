rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: users can view profiles, create/update only their own
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;

      // Saved posts subcollection
      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Communities and memberships
    match /communities/{communityId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if false;

      // Members subcollection
      match /members/{memberId} {
        allow read: if true;
        allow write: if isOwner(memberId);
      }
    }

    // Posts, comments, and votes
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Authors can update content; any authenticated user can increment upvotes/commentsCount
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated();
      }

      // Votes subcollection
      match /votes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // Official Notices: publicly readable; creation/modification by authenticated users
    match /notices/{noticeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
